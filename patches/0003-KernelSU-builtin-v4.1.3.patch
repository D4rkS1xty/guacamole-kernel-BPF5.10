+
+    ksu_adb_root_init();
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+    ksu_selinux_hide_init();
+#endif
+
+    ksu_kernel_umount_init();
+
+    ksu_allowlist_init();
+
+    ksu_throne_tracker_init();
+
+    ksu_ksud_init();
+
+    ksu_file_wrapper_init();
+
+    return 0;
+}
+device_initcall(kernelsu_init);
+
