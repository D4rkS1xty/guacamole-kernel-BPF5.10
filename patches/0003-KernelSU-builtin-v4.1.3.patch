+    apply_kernelsu_rules();
+    cache_sid();
+    setup_ksu_cred();
+    ksu_load_allow_list();
+    ksu_observer_init();
+    track_throne(false);
+    /* Retry after 3 s — packages.list may not be ready when zygote starts */
+    schedule_delayed_work(&delayed_throne_work, msecs_to_jiffies(3000));
